[Unit]
Description=Cloudflare Tunnel for Notserver Monitor
After=network-online.target notserver-monitor.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --config %h/.config/cloudflared-notserver-monitor.yml tunnel run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
