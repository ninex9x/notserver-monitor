[Unit]
Description=Notserver Monitor API and dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/notserver-monitor
ExecStart=/usr/bin/node server.mjs
EnvironmentFile=%h/.config/notserver-monitor.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
