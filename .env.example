# Servidor HTTP: mantenha o bind local atrás de SSH ou proxy HTTPS.
HOST=127.0.0.1
PORT=4242

# Coleta: o modelo inicia com dados fictícios para ser seguro ao copiar.
MONITOR_DEMO=true
MONITOR_LOCAL=false
NOTSERVER_SSH_TARGET=notserver

# Autenticação: em produção, prefira um arquivo com permissão 0600.
MONITOR_ACCESS_TOKEN=
MONITOR_ACCESS_TOKEN_FILE=

# Proxy e atualização privada do Android.
MONITOR_PUBLIC_ORIGIN=
MONITOR_UPDATE_DIR=updates
